# ============================================================
# Market Flow Intelligence System — 환경변수 설정 템플릿
#
# 사용 방법:
#   1. 이 파일을 복사해서 이름을 ".env" 로 변경하세요
#      (Windows)  copy .env.example .env
#      (Mac/Linux) cp .env.example .env
#   2. 아래 각 항목에 실제 값을 입력하세요
#   3. .env 파일은 절대 GitHub 등에 업로드하지 마세요
# ============================================================

# ------------------------------------------------------------
# [필수] Claude (Anthropic) API 키
# 발급: https://console.anthropic.com → API Keys → Create Key
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-여기에_API_키를_입력하세요
CLAUDE_MODEL=claude-sonnet-4-6

# ------------------------------------------------------------
# [선택] 이메일 자동 발송 설정
# 이메일 기능을 사용하지 않는다면 비워두어도 됩니다.
#
# Gmail 앱 비밀번호 발급 방법:
#   1. Google 계정 → 보안 → 2단계 인증 켜기
#   2. 앱 비밀번호 → 앱: 기타(MarketFlow) → 생성
#   3. 생성된 16자리 비밀번호를 SMTP_PASSWORD에 입력
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
EMAIL_FROM=your_gmail@gmail.com
EMAIL_TO=recipient@example.com

# ------------------------------------------------------------
# 데이터 수집 모드
#   true  → Mock 데이터 (인터넷 불필요, 테스트·데모용)
#   false → yfinance 실제 데이터 (인터넷 연결 필요)
# ------------------------------------------------------------
USE_MOCK_DATA=true

# ------------------------------------------------------------
# [선택] 네이버 개발자센터 API (국내 종목 뉴스)
# 발급: https://developers.naver.com/apps → 애플리케이션 등록
# 미설정 시 국내 종목 뉴스는 테스트 데이터로 대체됩니다.
# ------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ------------------------------------------------------------
# [선택] DART(금융감독원 전자공시) API — 국내 종목 공시 연동
# 발급: https://opendart.fss.or.kr (무료)
# 미설정 시 공시 데이터는 수집되지 않습니다.
# ------------------------------------------------------------
DART_API_KEY=

# ------------------------------------------------------------
# [선택] KIS(한국투자증권) Open API — 국내 종목 공식 수급(외국인/기관/개인) 데이터
# 사전 준비: 한국투자증권 계좌 개설(비대면 가능) → 오픈API 서비스 신청 → 앱키/앱시크릿 발급
# 모의투자 앱키도 실계좌 소유가 필요하지만, 시세 조회만 하므로 모의투자(demo)로 충분합니다.
# 미설정 시 국내 종목 수급 데이터는 네이버 금융 스크래핑으로 자동 폴백됩니다.
# ------------------------------------------------------------
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=demo

# ------------------------------------------------------------
# [선택] FRED(St. Louis 연준) API — 미국 매크로 지표(CPI/PPI/고용/소매판매/GDP) 발표일 캘린더
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html (무료, 즉시 발급)
# 미설정 시 이벤트 캘린더에서 미국 매크로 지표 항목만 빠지고, FOMC/한국은행 일정·
# 국내 법정 공시기한·DART 공시 항목은 계속 표시됩니다.
# ------------------------------------------------------------
FRED_API_KEY=

# ------------------------------------------------------------
# [선택] 텔레그램 알림 설정
# 등급이 크게 변하거나 위험 신호가 감지될 때만 알림을 보냅니다.
# 사용하지 않는다면 두 항목 모두 비워두세요.
#
# 봇 생성 방법:
#   1. 텔레그램 → @BotFather 검색 → /newbot → 토큰 발급
#   2. 발급받은 봇에게 채팅 메시지 1회 전송
#   3. https://api.telegram.org/bot{TOKEN}/getUpdates 에서 chat_id 확인
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# 리포트 저장 경로 (기본값 유지 권장)
# ------------------------------------------------------------
REPORT_SAVE_DIR=data/reports
REPORT_LANGUAGE=ko
